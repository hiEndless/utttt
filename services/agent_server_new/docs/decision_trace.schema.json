{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_server_new/decision_trace.schema.json",
  "title": "Agent Decision Trace Output",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "exchange": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "ts": {
      "type": "integer"
    },
    "event": {
      "type": "object"
    },
    "msl": {
      "type": "object"
    },
    "key_features": {
      "type": "object"
    },
    "evidence": {
      "type": "object"
    },
    "anomalies": {
      "type": "object"
    },
    "signal_verdict": {
      "type": "object"
    },
    "routing": {
      "type": "object",
      "properties": {
        "pipeline_mode": {
          "type": "string",
          "enum": ["legacy", "minimal"]
        },
        "decision_agent_key": {
          "type": "string"
        },
        "decision_mode": {
          "type": "string",
          "enum": ["llm", "rule_fallback", "rule"]
        },
        "llm_parse_status": {
          "type": "string",
          "enum": ["llm_ok", "llm_invalid_payload", "llm_status_not_ok", "llm_not_provided", "rule_only"]
        },
        "llm_contract_error_code": {
          "type": "string",
          "enum": [
            "",
            "llm_raw_content_missing",
            "llm_json_parse_error",
            "llm_json_not_object",
            "llm_schema_validation_failed",
            "llm_confidence_parse_error"
          ]
        },
        "llm_contract_errors": {
          "type": "array",
          "items": {"type": "string"},
          "maxItems": 8
        },
        "router_config_source": {
          "type": "string"
        },
        "router_config_version": {
          "type": "string"
        }
      },
      "required": [
        "pipeline_mode",
        "decision_agent_key",
        "decision_mode",
        "llm_parse_status",
        "llm_contract_error_code",
        "llm_contract_errors",
        "router_config_source",
        "router_config_version"
      ],
      "additionalProperties": true
    },
    "intent": {
      "type": "object"
    },
    "rule_plan": {
      "type": "object"
    },
    "strategy_gate_result": {
      "type": "object"
    },
    "risk_gate": {
      "type": "object"
    },
    "execution_plan": {
      "type": "object"
    },
    "llm_observation": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "disabled",
            "ok",
            "error"
          ]
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "raw_content_hash": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "provider",
        "model",
        "raw_content_hash"
      ],
      "additionalProperties": true
    },
    "memory_metrics": {
      "type": "object"
    },
    "contract_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "alert_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "event_id",
    "exchange",
    "symbol",
    "ts",
    "event",
    "msl",
    "key_features",
    "evidence",
    "anomalies",
    "signal_verdict",
    "routing",
    "intent",
    "rule_plan",
    "strategy_gate_result",
    "risk_gate",
    "execution_plan",
    "llm_observation",
    "memory_metrics",
    "contract_warnings",
    "alert_codes",
    "tags"
  ],
  "additionalProperties": false
}
