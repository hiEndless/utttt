# market_state_engine provider 配置
AGENT_MARKET_STATE_BASE_URL=http://127.0.0.1:8300
AGENT_MARKET_STATE_TIMEOUT_S=10

# runtime profile（prod/dev）
AGENT_RUNTIME_PROFILE=dev

# execution_service provider 配置（可选，默认关闭）
AGENT_EXECUTION_ENABLED=false
AGENT_EXECUTION_BASE_URL=http://127.0.0.1:9962
AGENT_EXECUTION_TIMEOUT_S=10
AGENT_EXECUTION_RETRY_MAX=0
AGENT_EXECUTION_RETRY_BACKOFF_S=0.2
AGENT_EXECUTION_RETRY_ON_STATUSES=429,500,502,503,504

# LLM 运行时预留（默认关闭；当前决策主链路仍为规则引擎）
AGENT_LLM_ENABLED=false
AGENT_LLM_PROVIDER=openai_compatible
AGENT_LLM_MODEL_ID=
AGENT_LLM_BASE_URL=
AGENT_LLM_API_KEY=
# 可选：从指定环境变量读取 API Key（优先级低于 AGENT_LLM_API_KEY）
# AGENT_LLM_API_KEY_ENV=OPENAI_API_KEY

# active_events provider 配置（当前仅支持 redis）
AGENT_ACTIVE_EVENTS_PROVIDER_MODE=redis
AGENT_ACTIVE_EVENTS_ALLOW_NULL_FALLBACK=false
# Redis backend 配置（当 AGENT_ACTIVE_EVENTS_PROVIDER_MODE=redis）
AGENT_ACTIVE_EVENTS_REDIS_URL=redis://127.0.0.1:6379/0
AGENT_ACTIVE_EVENTS_STREAM=ec:selected
AGENT_ACTIVE_EVENTS_LIMIT_DEFAULT=20
AGENT_ACTIVE_EVENTS_SCAN_FACTOR=5

# event recorder 配置（可选）
AGENT_EVENT_RECORDER_MODE=none
AGENT_EVENT_RECORDER_JSONL_PATH=verification/reports/agent_server_new_events.jsonl
AGENT_EVENT_RECORDER_ROTATE_DAILY=true
AGENT_EVENT_RECORDER_MAX_BYTES=10485760

# readyz 上游检查开关（可选）
AGENT_READY_CHECK_MARKET_STATE=true
AGENT_READY_CHECK_EXECUTION_SERVICE=true
AGENT_READY_CHECK_ACTIVE_EVENTS_REDIS=true
AGENT_READY_CHECK_EVENT_RECORDER=true
AGENT_READY_CHECK_EVENT_RECORDER_MIN_FREE_BYTES=104857600
AGENT_READY_CHECK_UPSTREAM_STRICT=false
AGENT_READY_CHECK_TIMEOUT_S=1.5

# Symbol Memory（可选，默认关闭）
AGENT_SYMBOL_MEMORY_ENABLED=false
AGENT_SYMBOL_MEMORY_BACKEND=inmemory
# Redis backend 配置（当 AGENT_SYMBOL_MEMORY_BACKEND=redis）
AGENT_SYMBOL_MEMORY_REDIS_URL=redis://127.0.0.1:6379/0
AGENT_SYMBOL_MEMORY_RAW_KEY_TEMPLATE=agent:memory:raw:{exchange}:{symbol}
AGENT_SYMBOL_MEMORY_SUMMARY_KEY_TEMPLATE=agent:memory:summary:{exchange}:{symbol}
AGENT_SYMBOL_MEMORY_INDEX_KEY=agent:memory:symbols:index
AGENT_SYMBOL_MEMORY_TTL_SECONDS=604800
AGENT_SYMBOL_MEMORY_RAW_TOPK=200
AGENT_SYMBOL_MEMORY_CONTEXT_TOPK=5
AGENT_SYMBOL_MEMORY_CONTEXT_TTL_MS=86400000
AGENT_SYMBOL_MEMORY_CONTEXT_DEDUP_KEY=event_id

# AI Adaptive 预留（默认关闭）
AGENT_AI_ADAPTIVE_ENABLED=false
AGENT_AI_ADAPTIVE_MODE=observe

# HorizonPolicyGate 配置（可选）
# 默认阻断策略：wait_confirmation,reduce_risk
AGENT_HORIZON_POLICY_BLOCK_ON_INCREASE=wait_confirmation,reduce_risk

# JSON 配置（可选），优先于默认值；若同时设置 CSV，则 CSV 会覆盖 block_on_increase_policies
# AGENT_HORIZON_POLICY_CONFIG_JSON={"block_on_increase_policies":["reduce_risk"]}
