{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecutionSignalResult",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "signal_action",
    "mode",
    "scope",
    "position_before",
    "position_after_simulation",
    "risk_checks"
  ],
  "properties": {
    "signal_action": {
      "type": "string",
      "enum": [
        "add_long",
        "add_short",
        "reduce_long",
        "reduce_short",
        "hold",
        "skip",
        "exit_all"
      ]
    },
    "risk_state": {
      "type": "string",
      "enum": ["normal", "warn", "reduce_only", "frozen"]
    },
    "mode": {
      "type": "string",
      "enum": ["simulated"]
    },
    "scope": {
      "type": "object",
      "required": ["exchange", "account_id", "symbol"],
      "properties": {
        "exchange": {"type": "string", "minLength": 1},
        "account_id": {"type": "string", "minLength": 1},
        "symbol": {"type": "string", "minLength": 1}
      }
    },
    "position_before": {
      "type": "object",
      "required": ["mode", "long_position_size", "short_position_size", "net_position_size"],
      "properties": {
        "mode": {"type": "string", "enum": ["one_way", "hedge"]},
        "long_position_size": {"type": "number"},
        "short_position_size": {"type": "number"},
        "net_position_size": {"type": "number"}
      }
    },
    "position_after_simulation": {
      "type": "object",
      "required": ["long_position_size", "short_position_size", "net_position_size"],
      "properties": {
        "long_position_size": {"type": "number"},
        "short_position_size": {"type": "number"},
        "net_position_size": {"type": "number"}
      }
    },
    "risk_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check", "scope", "status", "value", "threshold", "message_zh"],
        "properties": {
          "check": {
            "type": "string",
            "enum": [
              "account_drawdown_limit",
              "account_available_balance",
              "account_notional_limit",
              "account_margin_ratio_limit",
              "account_daily_loss_limit",
              "account_consecutive_loss_limit",
              "symbol_exposure_ratio",
              "long_leg_position_limit",
              "short_leg_position_limit"
            ]
          },
          "scope": {"type": "string", "enum": ["account", "symbol", "position"]},
          "status": {"type": "string", "enum": ["pass", "fail"]},
          "value": {"type": "number"},
          "threshold": {"type": "number"},
          "message_zh": {"type": "string", "minLength": 1}
        }
      }
    },
    "rule_debug": {
      "type": "object",
      "required": ["hit_rule", "rule_priority_order", "previous_risk_state", "current_risk_state", "risk_state_changed", "matched_at_ms"],
      "properties": {
        "hit_rule": {"type": "string", "minLength": 1},
        "rule_priority_order": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "hit_rule_value": {"type": ["number", "null"]},
        "hit_rule_threshold": {"type": ["number", "null"]},
        "previous_risk_state": {"type": "string", "enum": ["normal", "warn", "reduce_only", "frozen"]},
        "current_risk_state": {"type": "string", "enum": ["normal", "warn", "reduce_only", "frozen"]},
        "risk_state_changed": {"type": "boolean"},
        "matched_at_ms": {"type": "integer", "minimum": 1},
        "evaluation_trace": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["order", "rule", "scope", "status", "value", "threshold", "note_zh"],
            "properties": {
              "order": {"type": "integer", "minimum": 1},
              "rule": {"type": "string", "minLength": 1},
              "scope": {"type": "string", "enum": ["account", "symbol", "position"]},
              "status": {"type": "string", "enum": ["pass", "fail"]},
              "value": {"type": ["number", "null"]},
              "threshold": {"type": ["number", "null"]},
              "note_zh": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
