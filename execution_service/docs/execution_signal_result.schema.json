{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecutionSignalResult",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "signal_action",
    "mode",
    "scope",
    "position_before",
    "position_after_simulation",
    "risk_checks"
  ],
  "properties": {
    "signal_action": {
      "type": "string",
      "enum": [
        "add_long",
        "add_short",
        "reduce_long",
        "reduce_short",
        "hold",
        "skip",
        "exit_all"
      ]
    },
    "risk_state": {"$ref": "./risk_state.schema.json#/properties/risk_state"},
    "mode": {
      "type": "string",
      "enum": ["simulated"]
    },
    "scope": {"$ref": "./signal_scope.schema.json#/properties/scope"},
    "position_before": {"$ref": "./position_before.schema.json#/properties/position_before"},
    "position_after_simulation": {"$ref": "./position_after_simulation.schema.json#/properties/position_after_simulation"},
    "risk_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check", "scope", "status", "value", "threshold", "message_zh"],
        "properties": {
          "check": {
            "type": "string",
            "enum": [
              "account_drawdown_limit",
              "account_available_balance",
              "account_notional_limit",
              "account_margin_ratio_limit",
              "account_daily_loss_limit",
              "account_consecutive_loss_limit",
              "symbol_exposure_ratio",
              "long_leg_position_limit",
              "short_leg_position_limit"
            ]
          },
          "scope": {"type": "string", "enum": ["account", "symbol", "position"]},
          "status": {"type": "string", "enum": ["pass", "fail"]},
          "value": {"type": "number"},
          "threshold": {"type": "number"},
          "message_zh": {"type": "string", "minLength": 1}
        }
      }
    },
    "rule_debug": {"$ref": "./rule_debug.schema.json"}
  }
}
