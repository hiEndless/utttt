{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecutionReconcileResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "order_id",
    "status",
    "ts"
  ],
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["mock", "exchange_skeleton"]
    },
    "venue": {
      "type": "string"
    },
    "order_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_id": {
      "type": ["string", "null"]
    },
    "account_id": {
      "type": ["string", "null"]
    },
    "exchange": {
      "type": ["string", "null"]
    },
    "symbol": {
      "type": ["string", "null"]
    },
    "status": {
      "type": "string",
      "enum": ["submitted", "filled", "canceled", "rejected", "failed"]
    },
    "filled_qty": {
      "type": "number"
    },
    "avg_price": {
      "type": ["number", "null"]
    },
    "note": {
      "type": "string"
    },
    "reason_code": {
      "type": "string",
      "enum": ["reconcile_retry_exhausted", "reconcile_non_retryable_error", "reconcile_in_progress"]
    },
    "error_message": {
      "type": "string"
    },
    "idempotency_hit": {
      "type": "boolean"
    },
    "retry_meta": {
      "$ref": "./retry_meta.schema.json"
    },
    "dry_run": {
      "type": "boolean"
    },
    "exchange_status_raw": {
      "type": "string"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "side", "type", "quantity", "newClientOrderId"],
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "side": {
          "type": "string",
          "enum": ["BUY", "SELL"]
        },
        "type": {
          "type": "string",
          "enum": ["MARKET"]
        },
        "quantity": {
          "type": "string",
          "minLength": 1
        },
        "newClientOrderId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "exchange_raw": {
      "type": "object",
      "additionalProperties": true
    },
    "ts_ms": {
      "type": "integer",
      "minimum": 1
    },
    "ts": {
      "type": "integer",
      "minimum": 1
    }
  }
}
