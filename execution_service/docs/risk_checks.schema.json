{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RiskChecks",
  "type": "object",
  "properties": {
    "risk_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check", "scope", "status", "value", "threshold", "message_zh"],
        "properties": {
          "check": {
            "type": "string",
            "enum": [
              "account_drawdown_limit",
              "account_available_balance",
              "account_notional_limit",
              "account_margin_ratio_limit",
              "account_daily_loss_limit",
              "account_consecutive_loss_limit",
              "symbol_exposure_ratio",
              "long_leg_position_limit",
              "short_leg_position_limit"
            ]
          },
          "scope": {"type": "string", "enum": ["account", "symbol", "position"]},
          "status": {"type": "string", "enum": ["pass", "fail"]},
          "value": {"type": "number"},
          "threshold": {"type": "number"},
          "message_zh": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
