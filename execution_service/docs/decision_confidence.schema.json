{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DecisionConfidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["level", "score"],
  "properties": {
    "level": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  }
}
