{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecutionRiskPolicy",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "max_position_size",
    "max_long_position_size",
    "max_short_position_size",
    "max_drawdown_ratio",
    "position_mode",
    "allow_dual_side",
    "min_available_balance",
    "max_symbol_exposure_ratio",
    "simulation_step_size"
  ],
  "properties": {
    "max_position_size": {"type": "number", "minimum": 0},
    "max_long_position_size": {"type": "number", "minimum": 0},
    "max_short_position_size": {"type": "number", "minimum": 0},
    "max_drawdown_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "position_mode": {"type": "string", "enum": ["one_way", "hedge"]},
    "allow_dual_side": {"type": "boolean"},
    "min_available_balance": {"type": "number", "minimum": 0},
    "max_symbol_exposure_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "max_account_notional": {"type": "number", "minimum": 0},
    "max_margin_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "max_daily_loss": {"type": "number", "minimum": 0},
    "max_consecutive_loss_count": {"type": "integer", "minimum": 0},
    "simulation_step_size": {"type": "number", "minimum": 0},
    "rule_priority_order": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "position_limit",
          "cooldown",
          "max_drawdown",
          "account_notional",
          "margin_ratio",
          "daily_loss",
          "consecutive_loss",
          "direction_conflict"
        ]
      },
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true
    }
  }
}
