{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvaluationTrace",
  "type": "object",
  "properties": {
    "evaluation_trace": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["order", "rule", "scope", "status", "value", "threshold", "note_zh"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "rule": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "enum": ["account", "symbol", "position"]},
          "status": {"type": "string", "enum": ["pass", "fail"]},
          "value": {"type": ["number", "null"]},
          "threshold": {"type": ["number", "null"]},
          "note_zh": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
