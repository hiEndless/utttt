{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DecisionIntent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "exchange",
    "account_id",
    "symbol",
    "direction_intent",
    "cross_horizon_policy",
    "risk_hints"
  ],
  "anyOf": [
    {
      "required": ["confidence"]
    },
    {
      "required": ["decision_confidence"]
    }
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "exchange": {
      "type": "string",
      "minLength": 1
    },
    "account_id": {
      "type": "string",
      "minLength": 1
    },
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "direction_intent": {
      "type": "string",
      "enum": ["long", "short", "none"]
    },
    "confidence": {
      "description": "兼容字段。决策置信度，建议与 decision_confidence 保持一致。",
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "score"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    },
    "decision_confidence": {
      "description": "语义主字段。若与 confidence 同时出现，应用层要求两者一致（JSON Schema 无法表达跨字段相等约束）。",
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "score"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    },
    "cross_horizon_policy": {
      "type": "object",
      "additionalProperties": true
    },
    "risk_hints": {
      "type": "object",
      "additionalProperties": true
    },
    "trace_id": {
      "type": ["string", "null"]
    }
  }
}
