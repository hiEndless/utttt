{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecutionDecisionState",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "decision_id",
    "account_id",
    "status",
    "last_transition",
    "attempts",
    "source",
    "updated_at_ms"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "account_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["pending", "submitted", "failed", "skipped", "decided", "filled", "canceled", "rejected"]
    },
    "last_transition": {
      "type": "string",
      "enum": ["pending", "submitted", "failed", "skipped", "decided", "filled", "canceled", "rejected"]
    },
    "execution_action": {
      "type": "string",
      "enum": ["add", "reduce", "hold", "exit", "skip"]
    },
    "reject_reason": {
      "type": ["string", "null"]
    },
    "risk_state": {
      "type": "string",
      "enum": ["normal", "warn", "reduce_only", "frozen"]
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    },
    "submitted_at_ms": {
      "type": ["integer", "null"]
    },
    "last_error": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "const": "execution_service"
    },
    "trace_id": {
      "type": ["string", "null"]
    },
    "rule_debug": {
      "type": "object",
      "required": ["hit_rule", "rule_priority_order", "matched_at_ms"],
      "properties": {
        "hit_rule": {"type": "string", "minLength": 1},
        "rule_priority_order": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "hit_rule_value": {"type": ["number", "null"]},
        "hit_rule_threshold": {"type": ["number", "null"]},
        "matched_at_ms": {"type": "integer", "minimum": 1},
        "evaluation_trace": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["order", "rule", "scope", "status", "value", "threshold", "note_zh"],
            "properties": {
              "order": {"type": "integer", "minimum": 1},
              "rule": {"type": "string", "minLength": 1},
              "scope": {"type": "string", "enum": ["account", "symbol", "position"]},
              "status": {"type": "string", "enum": ["pass", "fail"]},
              "value": {"type": ["number", "null"]},
              "threshold": {"type": ["number", "null"]},
              "note_zh": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "updated_at_ms": {
      "type": "integer",
      "minimum": 1
    }
  }
}
