{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecutionDecisionState",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "decision_id",
    "account_id",
    "status",
    "last_transition",
    "attempts",
    "source",
    "updated_at_ms"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "account_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["pending", "submitted", "failed", "skipped", "decided", "filled", "canceled", "rejected"]
    },
    "last_transition": {
      "type": "string",
      "enum": ["pending", "submitted", "failed", "skipped", "decided", "filled", "canceled", "rejected"]
    },
    "execution_action": {
      "type": "string",
      "enum": ["add", "reduce", "hold", "exit", "skip"]
    },
    "reject_reason": {
      "type": ["string", "null"]
    },
    "risk_state": {"$ref": "./risk_state.schema.json#/properties/risk_state"},
    "attempts": {
      "type": "integer",
      "minimum": 0
    },
    "submitted_at_ms": {
      "type": ["integer", "null"]
    },
    "last_error": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "const": "execution_service"
    },
    "trace_id": {
      "type": ["string", "null"]
    },
    "rule_debug": {"$ref": "./rule_debug.schema.json"},
    "updated_at_ms": {
      "type": "integer",
      "minimum": 1
    }
  }
}
