{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RuleDebug",
  "type": "object",
  "required": [
    "hit_rule",
    "rule_priority_order",
    "previous_risk_state",
    "current_risk_state",
    "risk_state_changed",
    "risk_state_change_reason",
    "risk_state_change_reason_zh",
    "matched_at_ms"
  ],
  "properties": {
    "hit_rule": {"type": "string", "minLength": 1},
    "rule_priority_order": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "hit_rule_value": {"type": ["number", "null"]},
    "hit_rule_threshold": {"type": ["number", "null"]},
    "previous_risk_state": {"$ref": "./risk_state.schema.json#/properties/risk_state"},
    "current_risk_state": {"$ref": "./risk_state.schema.json#/properties/risk_state"},
    "risk_state_changed": {"type": "boolean"},
    "risk_state_change_reason": {"$ref": "./risk_state_change_reason.schema.json#/properties/reason_code"},
    "risk_state_change_reason_zh": {"$ref": "./risk_state_change_reason.schema.json#/properties/reason_zh"},
    "matched_at_ms": {"type": "integer", "minimum": 1},
    "evaluation_trace": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["order", "rule", "scope", "status", "value", "threshold", "note_zh"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "rule": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "enum": ["account", "symbol", "position"]},
          "status": {"type": "string", "enum": ["pass", "fail"]},
          "value": {"type": ["number", "null"]},
          "threshold": {"type": ["number", "null"]},
          "note_zh": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
