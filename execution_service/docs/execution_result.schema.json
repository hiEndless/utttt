{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecutionResult",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "decision_id",
    "execution_action",
    "reject_reason",
    "applied_risk_rules"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "execution_action": {
      "$ref": "./execution_action.schema.json#/properties/execution_action"
    },
    "reject_reason": {
      "$ref": "./reject_reason.schema.json#/properties/reject_reason"
    },
    "applied_risk_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "order_result": {
      "type": "object",
      "properties": {
        "retry_meta": {
          "$ref": "./retry_meta.schema.json"
        }
      }
    },
    "signal_result": {
      "$ref": "./execution_signal_result.schema.json"
    },
    "notes": {
      "type": "string"
    }
  }
}
