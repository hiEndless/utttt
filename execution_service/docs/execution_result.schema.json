{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecutionResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "execution_action",
    "reject_reason",
    "applied_risk_rules"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "execution_action": {
      "$ref": "./execution_action.schema.json#/properties/execution_action"
    },
    "reject_reason": {
      "$ref": "./reject_reason.schema.json#/properties/reject_reason"
    },
    "applied_risk_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "order_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "submitted": {"$ref": "./execution_io_payload.schema.json#/properties/submitted"},
        "mode": {"$ref": "./execution_io_payload.schema.json#/properties/mode"},
        "dry_run": {"$ref": "./execution_io_payload.schema.json#/properties/dry_run"},
        "venue": {"$ref": "./execution_io_payload.schema.json#/properties/venue"},
        "order_id": {"$ref": "./execution_io_payload.schema.json#/properties/order_id"},
        "decision_id": {"$ref": "./execution_io_payload.schema.json#/properties/decision_id"},
        "exchange": {"$ref": "./execution_io_payload.schema.json#/properties/exchange"},
        "account_id": {"$ref": "./execution_io_payload.schema.json#/properties/account_id"},
        "symbol": {"$ref": "./execution_io_payload.schema.json#/properties/symbol"},
        "direction_intent": {
          "type": "string",
          "enum": ["long", "short", "none"]
        },
        "execution_action": {
          "$ref": "./execution_action.schema.json#/properties/execution_action"
        },
        "status": {"$ref": "./execution_io_payload.schema.json#/properties/status"},
        "request": {"$ref": "./execution_io_payload.schema.json#/properties/request"},
        "exchange_raw": {"$ref": "./execution_io_payload.schema.json#/properties/exchange_raw"},
        "ts": {"$ref": "./execution_io_payload.schema.json#/properties/ts"},
        "ts_ms": {"$ref": "./execution_io_payload.schema.json#/properties/ts_ms"},
        "submitted_at_ms": {"$ref": "./execution_io_payload.schema.json#/properties/submitted_at_ms"},
        "retry_meta": {
          "$ref": "./retry_meta.schema.json"
        }
      }
    },
    "signal_result": {
      "$ref": "./execution_signal_result.schema.json"
    },
    "policy_snapshot": {
      "$ref": "./policy_snapshot.schema.json"
    },
    "notes": {
      "type": "string"
    }
  }
}
