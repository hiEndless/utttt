{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SelectedEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asset",
    "ts_ms",
    "selected_type",
    "direction_hint",
    "priority",
    "context_snapshot",
    "route"
  ],
  "properties": {
    "asset": {
      "type": "string",
      "minLength": 1
    },
    "ts_ms": {
      "type": "integer",
      "minimum": 1
    },
    "selected_type": {
      "type": "string",
      "minLength": 1
    },
    "direction_hint": {
      "type": "string",
      "enum": ["bullish", "bearish", "neutral", "mixed"]
    },
    "priority": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "context_snapshot": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "horizon": {
          "type": "string",
          "minLength": 1
        },
        "key_evidences": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "trigger_event": {
      "type": ["object", "null"]
    },
    "source": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["name", "category"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trace": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "dedup_key": {
          "type": ["string", "null"]
        },
        "correlation_id": {
          "type": ["string", "null"]
        },
        "parent_id": {
          "type": ["string", "null"]
        },
        "produced_by": {
          "type": ["string", "null"]
        },
        "schema_version": {
          "type": ["string", "null"]
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "horizon": {
          "type": "string",
          "minLength": 1
        },
        "consumer": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "review_required": {
          "type": "boolean"
        }
      }
    }
  }
}
