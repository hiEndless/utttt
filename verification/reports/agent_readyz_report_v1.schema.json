{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentReadyzReportV1",
  "type": "object",
  "required": [
    "schema_version",
    "source_url",
    "collected_at_ms",
    "ok",
    "status_level",
    "runtime_profile",
    "warnings",
    "errors",
    "checks",
    "raw_readyz"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "agent-readyz-report-v1"
    },
    "source_url": {
      "type": "string",
      "minLength": 1
    },
    "collected_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "ok": {
      "type": "boolean"
    },
    "status_level": {
      "type": "string",
      "enum": [
        "green",
        "yellow",
        "red"
      ]
    },
    "runtime_profile": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checks": {
      "type": "object"
    },
    "raw_readyz": {
      "type": "object"
    }
  }
}
