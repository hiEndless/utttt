{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VerificationReportAggregateV1",
  "type": "object",
  "required": [
    "schema_version",
    "verification_report_count",
    "report_count",
    "passed",
    "failed",
    "pass_rate",
    "avg_duration_ms",
    "latest_finished_at_ms",
    "suites",
    "semantic_audit_count",
    "semantic_error_count",
    "semantic_warning_count",
    "latest_semantic_report_path",
    "memory_summary_run_count",
    "latest_memory_summary_report_path",
    "memory_high_risk_symbol_count",
    "memory_top_risk_score",
    "memory_high_risk_symbols",
    "memory_alert_code_count",
    "memory_top_alert_codes",
    "execution_confidence_report_count",
    "latest_execution_confidence_report_path",
    "execution_confidence_only_requests",
    "execution_decision_confidence_requests",
    "execution_confidence_alias_mismatch_rejections",
    "execution_legacy_confidence_usage_ratio",
    "agent_readyz_report_count",
    "latest_agent_readyz_report_path",
    "agent_readyz_ok",
    "agent_readyz_status_level",
    "agent_readyz_warning_count",
    "agent_readyz_error_count",
    "agent_readyz_errors",
    "decision_trace_schema_guard_report_count",
    "latest_decision_trace_schema_guard_report_path",
    "decision_trace_schema_guard_invalid_records",
    "decision_trace_schema_guard_affected_event_count"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "verification-report-aggregate-v1"
    },
    "verification_report_count": {
      "type": "integer",
      "minimum": 0
    },
    "report_count": {
      "type": "integer",
      "minimum": 0
    },
    "passed": {
      "type": "integer",
      "minimum": 0
    },
    "failed": {
      "type": "integer",
      "minimum": 0
    },
    "pass_rate": {
      "type": "number",
      "minimum": 0
    },
    "avg_duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "latest_finished_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "suites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "suite",
          "count",
          "passed",
          "failed",
          "avg_duration_ms",
          "latest_finished_at_ms"
        ],
        "properties": {
          "suite": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "passed": {
            "type": "integer",
            "minimum": 0
          },
          "failed": {
            "type": "integer",
            "minimum": 0
          },
          "avg_duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "latest_finished_at_ms": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "semantic_audit_count": {
      "type": "integer",
      "minimum": 0
    },
    "semantic_error_count": {
      "type": "integer",
      "minimum": 0
    },
    "semantic_warning_count": {
      "type": "integer",
      "minimum": 0
    },
    "latest_semantic_report_path": {
      "type": "string"
    },
    "memory_summary_run_count": {
      "type": "integer",
      "minimum": 0
    },
    "latest_memory_summary_report_path": {
      "type": "string"
    },
    "memory_high_risk_symbol_count": {
      "type": "integer",
      "minimum": 0
    },
    "memory_top_risk_score": {
      "type": "number",
      "minimum": 0
    },
    "memory_high_risk_symbols": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "memory_alert_code_count": {
      "type": "integer",
      "minimum": 0
    },
    "memory_top_alert_codes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "alert_code",
          "count",
          "symbols",
          "symbol_count"
        ],
        "properties": {
          "alert_code": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "symbols": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "symbol_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "execution_confidence_report_count": {
      "type": "integer",
      "minimum": 0
    },
    "latest_execution_confidence_report_path": {
      "type": "string"
    },
    "execution_confidence_only_requests": {
      "type": "integer",
      "minimum": 0
    },
    "execution_decision_confidence_requests": {
      "type": "integer",
      "minimum": 0
    },
    "execution_confidence_alias_mismatch_rejections": {
      "type": "integer",
      "minimum": 0
    },
    "execution_legacy_confidence_usage_ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "agent_readyz_report_count": {
      "type": "integer",
      "minimum": 0
    },
    "latest_agent_readyz_report_path": {
      "type": "string"
    },
    "agent_readyz_ok": {
      "type": "boolean"
    },
    "agent_readyz_status_level": {
      "type": "string",
      "enum": ["green", "yellow", "red"]
    },
    "agent_readyz_warning_count": {
      "type": "integer",
      "minimum": 0
    },
    "agent_readyz_error_count": {
      "type": "integer",
      "minimum": 0
    },
    "agent_readyz_errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decision_trace_schema_guard_report_count": {
      "type": "integer",
      "minimum": 0
    },
    "latest_decision_trace_schema_guard_report_path": {
      "type": "string"
    },
    "decision_trace_schema_guard_invalid_records": {
      "type": "integer",
      "minimum": 0
    },
    "decision_trace_schema_guard_affected_event_count": {
      "type": "integer",
      "minimum": 0
    }
  }
}
