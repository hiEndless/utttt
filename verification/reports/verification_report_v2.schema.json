{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VerificationSuiteReportV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite",
    "git_sha",
    "env",
    "suite_tags",
    "status",
    "exit_code",
    "started_at_ms",
    "finished_at_ms",
    "duration_ms",
    "guards"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "verification-report-v2"
    },
    "suite": {
      "type": "string",
      "minLength": 1
    },
    "git_sha": {
      "type": "string",
      "minLength": 1
    },
    "env": {
      "type": "string",
      "minLength": 1
    },
    "suite_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": ["passed", "failed"]
    },
    "exit_code": {
      "type": "integer",
      "minimum": 0
    },
    "started_at_ms": {
      "type": "integer",
      "minimum": 1
    },
    "finished_at_ms": {
      "type": "integer",
      "minimum": 1
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "guards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "duration_ms"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["passed", "failed"]
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
